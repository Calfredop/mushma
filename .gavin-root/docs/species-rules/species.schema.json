{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mushma.local/schemas/species-rules/v1/species.schema.json",
  "title": "mushma species rule config (draft v1)",
  "description": "One file per scored species key. score = product(gates) * product(stoppers) * weighted geometric mean(drivers). See README.md in this folder. Cross-file checks (every source id exists in references.yaml, unique factor ids, trapezoid ordering) are done by the loader, not by this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "key",
    "group",
    "taxon",
    "status",
    "i18n_key",
    "records",
    "factors"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "key": {
      "description": "Engine species key; also the file name.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "group": {
      "description": "UI species this key rolls up into (the group score is the max over its keys).",
      "enum": [
        "porcini",
        "ovoli",
        "gallinacci"
      ]
    },
    "taxon": {
      "type": "string"
    },
    "synonyms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "tuned"
      ]
    },
    "i18n_key": {
      "type": "string",
      "pattern": "^species\\.[a-z0-9_]+$"
    },
    "records": {
      "description": "How sightings for this key are pulled for the backtest.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gbif_taxon_keys",
        "inat_taxon_ids"
      ],
      "properties": {
        "gbif_taxon_keys": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 1
        },
        "inat_taxon_ids": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 1
        },
        "exclude_basis_of_record": {
          "type": "array",
          "items": {
            "enum": [
              "MATERIAL_SAMPLE",
              "PRESERVED_SPECIMEN",
              "FOSSIL_SPECIMEN",
              "LIVING_SPECIMEN",
              "MACHINE_OBSERVATION"
            ]
          }
        },
        "notes": {
          "type": "string"
        },
        "exclude_gbif_taxon_keys": {
          "description": "Taxa nested under an included key that must not count (e.g. genus-level include with non-target species).",
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "exclude_inat_taxon_ids": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "factors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/factor"
      }
    },
    "known_gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/known_gap"
      }
    }
  },
  "$defs": {
    "confidence": {
      "enum": [
        "strong",
        "plausible",
        "folklore"
      ]
    },
    "ddmm": {
      "type": "string",
      "pattern": "^(0[1-9]|[12][0-9]|3[01])-(0[1-9]|1[0-2])$"
    },
    "num_or_null": {
      "type": [
        "number",
        "null"
      ]
    },
    "trapezoid": {
      "description": "[zero_below, full_from, full_to, zero_above]. 0 outside [a, d], linear ramps a->b and c->d, 1 on [b, c]. null a+b = open to -inf (1 below c); null c+d = open to +inf (1 above b). Loader checks a<=b<=c<=d.",
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/num_or_null"
        },
        {
          "$ref": "#/$defs/num_or_null"
        },
        {
          "$ref": "#/$defs/num_or_null"
        },
        {
          "$ref": "#/$defs/num_or_null"
        }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "daily_variable_available": {
      "description": "Daily variables verified against the Open-Meteo archive (best_match / era5_seamless) and forecast APIs on 2026-09-17, requested with timezone=Europe/Rome, plus two derived series: water_balance = precipitation_sum - et0_fao_evapotranspiration (mm); temperature_2m_max_anomaly_30d = temperature_2m_max minus the mean temperature_2m_max of the 30 days before (°C).",
      "enum": [
        "precipitation_sum",
        "rain_sum",
        "snowfall_sum",
        "precipitation_hours",
        "temperature_2m_min",
        "temperature_2m_max",
        "temperature_2m_mean",
        "soil_temperature_0_to_7cm_mean",
        "soil_temperature_7_to_28cm_mean",
        "soil_moisture_0_to_7cm_mean",
        "soil_moisture_7_to_28cm_mean",
        "wind_speed_10m_max",
        "wind_speed_10m_mean",
        "wind_gusts_10m_max",
        "wind_direction_10m_dominant",
        "et0_fao_evapotranspiration",
        "vapour_pressure_deficit_max",
        "relative_humidity_2m_mean",
        "relative_humidity_2m_min",
        "shortwave_radiation_sum",
        "water_balance",
        "temperature_2m_max_anomaly_30d"
      ]
    },
    "static_attribute_available": {
      "enum": [
        "elevation_m",
        "slope_deg",
        "aspect_deg",
        "northness"
      ]
    },
    "static_attribute_missing": {
      "description": "Not in the v1 grid. Rules on these must be enabled: false.",
      "enum": [
        "soil_ph",
        "soil_texture",
        "lithology_calcareous",
        "stand_age",
        "canopy_cover",
        "litter_depth"
      ]
    },
    "habitat": {
      "description": "Habitat vocabulary, owned by the woodland grid: api/src/api/config/habitats.yaml (api/tests/grid/test_habitats.py checks the two match). See ../woodland-grid.md for how cells get their habitat fractions. macchia and transitional_woodland_shrub count as wooded area but not towards the woodland mask.",
      "enum": [
        "beech",
        "chestnut",
        "deciduous_oak",
        "evergreen_oak",
        "mixed_broadleaf",
        "riparian",
        "exotic_broadleaf",
        "mediterranean_pine",
        "mountain_pine",
        "fir_spruce",
        "other_conifer",
        "mixed_broadleaf_conifer",
        "macchia",
        "transitional_woodland_shrub"
      ]
    },
    "factor_common": {
      "type": "object",
      "required": [
        "id",
        "role",
        "kind",
        "i18n_key",
        "confidence",
        "source",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "role": {
          "description": "gate: multiplicative suitability (season, habitat, altitude). driver: weather conditions, combined by weighted geometric mean. stopper: multiplicative penalty, 1 = no effect.",
          "enum": [
            "gate",
            "driver",
            "stopper"
          ]
        },
        "kind": {
          "enum": [
            "season_window",
            "habitat",
            "static_band",
            "rain_event",
            "window_aggregate",
            "count_days",
            "days_since"
          ]
        },
        "i18n_key": {
          "type": "string",
          "pattern": "^factor\\.[a-z0-9_.]+$"
        },
        "weight": {
          "description": "Drivers only.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "floor": {
          "description": "Minimum output of the factor (0-1), for rules too weak to zero a score on their own.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "source": {
          "description": "Reference ids in references.yaml. Never empty.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "minItems": 1
        },
        "derived": {
          "description": "true when the numbers were derived from a qualitative statement; notes must say how.",
          "type": "boolean"
        },
        "data": {
          "description": "available: inputs exist in v1. derived: computed from available inputs (e.g. water balance, a climatology). missing: needs data v1 does not have.",
          "enum": [
            "available",
            "derived",
            "missing"
          ]
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "driver"
              }
            }
          },
          "then": {
            "required": [
              "weight"
            ]
          },
          "else": {
            "not": {
              "required": [
                "weight"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "data": {
                "const": "missing"
              }
            }
          },
          "then": {
            "required": [
              "enabled"
            ],
            "properties": {
              "enabled": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "derived": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "notes"
            ]
          }
        }
      ]
    },
    "factor": {
      "oneOf": [
        {
          "$ref": "#/$defs/f_season_window"
        },
        {
          "$ref": "#/$defs/f_habitat"
        },
        {
          "$ref": "#/$defs/f_static_band"
        },
        {
          "$ref": "#/$defs/f_rain_event"
        },
        {
          "$ref": "#/$defs/f_window_aggregate"
        },
        {
          "$ref": "#/$defs/f_count_days"
        },
        {
          "$ref": "#/$defs/f_days_since"
        }
      ]
    },
    "f_season_window": {
      "description": "Value = max over windows of (day-of-year trapezoid x elevation_weight). Windows may wrap the year end. altitude_shift moves all four dates by days_per_100m * (elevation - reference_m) / 100. elevation_weight (a trapezoid over elevation_m, default 1) lets a lowland and a mountain window hand over across an elevation band.",
      "allOf": [
        {
          "$ref": "#/$defs/factor_common"
        }
      ],
      "unevaluatedProperties": false,
      "properties": {
        "kind": {
          "const": "season_window"
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "windows"
          ],
          "properties": {
            "windows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "dates"
                ],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "dates": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/ddmm"
                    },
                    "minItems": 4,
                    "maxItems": 4
                  },
                  "altitude_shift": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "reference_m",
                      "days_per_100m"
                    ],
                    "properties": {
                      "reference_m": {
                        "type": "number"
                      },
                      "days_per_100m": {
                        "type": "number"
                      }
                    }
                  },
                  "elevation_weight": {
                    "$ref": "#/$defs/trapezoid"
                  }
                }
              }
            }
          }
        }
      },
      "required": [
        "input"
      ]
    },
    "f_habitat": {
      "description": "Value = sum over the cell's habitat fractions of fraction * affinity (unlisted habitats score `default`).",
      "allOf": [
        {
          "$ref": "#/$defs/factor_common"
        }
      ],
      "unevaluatedProperties": false,
      "properties": {
        "kind": {
          "const": "habitat"
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "affinity"
          ],
          "properties": {
            "affinity": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/habitat"
              },
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "default": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      },
      "required": [
        "input"
      ]
    },
    "f_static_band": {
      "allOf": [
        {
          "$ref": "#/$defs/factor_common"
        }
      ],
      "unevaluatedProperties": false,
      "properties": {
        "kind": {
          "const": "static_band"
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attribute"
          ],
          "properties": {
            "attribute": {
              "anyOf": [
                {
                  "$ref": "#/$defs/static_attribute_available"
                },
                {
                  "$ref": "#/$defs/static_attribute_missing"
                }
              ]
            }
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trapezoid"
          ],
          "properties": {
            "trapezoid": {
              "$ref": "#/$defs/trapezoid"
            }
          }
        }
      },
      "required": [
        "input",
        "response"
      ]
    },
    "f_rain_event": {
      "description": "For each lag d whose lag response is > 0: A(d) = sum of `variable` over the accumulation_days ending d days before the target day. Value = max_d amount(A(d)) * lag(d). The breakdown reports the arg-max: 'A mm, d days ago'.",
      "allOf": [
        {
          "$ref": "#/$defs/factor_common"
        }
      ],
      "unevaluatedProperties": false,
      "properties": {
        "kind": {
          "const": "rain_event"
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "variable",
            "accumulation_days"
          ],
          "properties": {
            "variable": {
              "enum": [
                "precipitation_sum",
                "rain_sum"
              ]
            },
            "accumulation_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            }
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amount_mm",
            "lag_days"
          ],
          "properties": {
            "amount_mm": {
              "$ref": "#/$defs/trapezoid"
            },
            "lag_days": {
              "$ref": "#/$defs/trapezoid"
            }
          }
        }
      },
      "required": [
        "input",
        "response"
      ]
    },
    "f_window_aggregate": {
      "description": "Aggregate `variable` over the window_days ending offset_days before the target day, then apply the trapezoid. percent_of_normal = window sum as % of the cell's climatological mean sum for the same calendar window; percentile_of_normal = percentile (0-100) of the window mean within the cell's climatology for the same calendar window. Both need the history backfill climatology, so factors using them are data: derived.",
      "allOf": [
        {
          "$ref": "#/$defs/factor_common"
        }
      ],
      "unevaluatedProperties": false,
      "properties": {
        "kind": {
          "const": "window_aggregate"
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "variable",
            "aggregate",
            "window_days"
          ],
          "properties": {
            "variable": {
              "$ref": "#/$defs/daily_variable_available"
            },
            "aggregate": {
              "enum": [
                "sum",
                "mean",
                "min",
                "max",
                "percent_of_normal",
                "percentile_of_normal"
              ]
            },
            "window_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 180
            },
            "offset_days": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trapezoid"
          ],
          "properties": {
            "trapezoid": {
              "$ref": "#/$defs/trapezoid"
            }
          }
        }
      },
      "required": [
        "input",
        "response"
      ]
    },
    "f_count_days": {
      "description": "Count days in the window where `variable op threshold`, then apply the trapezoid to the count.",
      "allOf": [
        {
          "$ref": "#/$defs/factor_common"
        }
      ],
      "unevaluatedProperties": false,
      "properties": {
        "kind": {
          "const": "count_days"
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "variable",
            "op",
            "threshold",
            "window_days"
          ],
          "properties": {
            "variable": {
              "$ref": "#/$defs/daily_variable_available"
            },
            "op": {
              "enum": [
                "lt",
                "lte",
                "gt",
                "gte"
              ]
            },
            "threshold": {
              "type": "number"
            },
            "window_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            },
            "offset_days": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trapezoid"
          ],
          "properties": {
            "trapezoid": {
              "$ref": "#/$defs/trapezoid"
            }
          }
        }
      },
      "required": [
        "input",
        "response"
      ]
    },
    "f_days_since": {
      "description": "Days since the most recent day where `variable op threshold` (capped at max_lookback_days), then apply the trapezoid.",
      "allOf": [
        {
          "$ref": "#/$defs/factor_common"
        }
      ],
      "unevaluatedProperties": false,
      "properties": {
        "kind": {
          "const": "days_since"
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "variable",
            "op",
            "threshold",
            "max_lookback_days"
          ],
          "properties": {
            "variable": {
              "$ref": "#/$defs/daily_variable_available"
            },
            "op": {
              "enum": [
                "lt",
                "lte",
                "gt",
                "gte"
              ]
            },
            "threshold": {
              "type": "number"
            },
            "max_lookback_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 180
            }
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trapezoid"
          ],
          "properties": {
            "trapezoid": {
              "$ref": "#/$defs/trapezoid"
            }
          }
        }
      },
      "required": [
        "input",
        "response"
      ]
    },
    "known_gap": {
      "description": "An effect the sources support but v1 cannot encode (missing data, or no defensible parameters). Recorded so the gap stays visible.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "needs",
        "confidence",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "description": {
          "type": "string"
        },
        "needs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "source": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "minItems": 1
        }
      }
    }
  }
}
