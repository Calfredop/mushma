MUSHMA_FIXTURES=1

# Copernicus CDS (ERA5-Land history backfill for new regions). Get a key at
# https://cds.climate.copernicus.eu/how-to-api — either set this or write ~/.cdsapirc.
# CDSAPI_KEY=uid:api-key

# Production hardening (M7 · monitoring; all optional, unset is a safe no-op everywhere):
# ALERT_WEBHOOK_URL=      # api.jobs.daily posts one line here on a failed step
# HEARTBEAT_URL=          # api.jobs.daily pings this (a plain GET) once it finishes successfully
# SENTRY_DSN=             # error tracking for the API (api/src/api/main.py)
