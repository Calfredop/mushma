{
  "components": {
    "schemas": {
      "CellDetailResponse": {
        "description": "Shared shape for `GET /spot` and `GET /cells/{id}`: today plus a\n7-day outlook, per species, with the full factor breakdown.",
        "properties": {
          "cell_id": {
            "title": "Cell Id",
            "type": "string"
          },
          "lat": {
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "title": "Lon",
            "type": "number"
          },
          "place": {
            "$ref": "#/components/schemas/Place"
          },
          "species": {
            "items": {
              "$ref": "#/components/schemas/SpeciesForecast"
            },
            "title": "Species",
            "type": "array"
          }
        },
        "required": [
          "cell_id",
          "lon",
          "lat",
          "place",
          "species"
        ],
        "title": "CellDetailResponse",
        "type": "object"
      },
      "DayScore": {
        "properties": {
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "factors": {
            "items": {
              "$ref": "#/components/schemas/FactorBreakdown"
            },
            "title": "Factors",
            "type": "array"
          },
          "score": {
            "description": "0-1 conditions index, never a probability",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score",
            "type": "number"
          }
        },
        "required": [
          "date",
          "score",
          "factors"
        ],
        "title": "DayScore",
        "type": "object"
      },
      "FactorBreakdown": {
        "description": "One rule's contribution to a score, in evaluation order (gates, then\ndrivers, then stoppers) -- the \"why this score\" breakdown never re-sorts\nby magnitude, so the same species always reads in the same order.\n\n`contribution` is this factor's own multiplicative share of the day's\nscore: the product of every factor's `contribution` equals `score`.",
        "properties": {
          "contribution": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Contribution",
            "type": "number"
          },
          "i18n_key": {
            "title": "I18N Key",
            "type": "string"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "value": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Value",
            "type": "number"
          }
        },
        "required": [
          "key",
          "i18n_key",
          "value",
          "contribution"
        ],
        "title": "FactorBreakdown",
        "type": "object"
      },
      "GridCellScore": {
        "properties": {
          "cell_id": {
            "title": "Cell Id",
            "type": "string"
          },
          "lat": {
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "title": "Lon",
            "type": "number"
          },
          "score": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score",
            "type": "number"
          }
        },
        "required": [
          "cell_id",
          "lon",
          "lat",
          "score"
        ],
        "title": "GridCellScore",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Hotspot": {
        "properties": {
          "cell_ids": {
            "items": {
              "type": "string"
            },
            "title": "Cell Ids",
            "type": "array"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "lat": {
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "title": "Lon",
            "type": "number"
          },
          "place": {
            "$ref": "#/components/schemas/Place"
          },
          "recent_sightings": {
            "minimum": 0.0,
            "title": "Recent Sightings",
            "type": "integer"
          },
          "score": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score",
            "type": "number"
          }
        },
        "required": [
          "id",
          "place",
          "lon",
          "lat",
          "score",
          "cell_ids",
          "recent_sightings"
        ],
        "title": "Hotspot",
        "type": "object"
      },
      "HotspotsResponse": {
        "properties": {
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "hotspots": {
            "items": {
              "$ref": "#/components/schemas/Hotspot"
            },
            "title": "Hotspots",
            "type": "array"
          },
          "species": {
            "enum": [
              "porcini",
              "ovoli",
              "gallinacci",
              "combined"
            ],
            "title": "Species",
            "type": "string"
          }
        },
        "required": [
          "species",
          "date",
          "hotspots"
        ],
        "title": "HotspotsResponse",
        "type": "object"
      },
      "Place": {
        "properties": {
          "comune": {
            "title": "Comune",
            "type": "string"
          },
          "nearest_place": {
            "title": "Nearest Place",
            "type": "string"
          }
        },
        "required": [
          "comune",
          "nearest_place"
        ],
        "title": "Place",
        "type": "object"
      },
      "ScoresResponse": {
        "properties": {
          "cells": {
            "items": {
              "$ref": "#/components/schemas/GridCellScore"
            },
            "title": "Cells",
            "type": "array"
          },
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "species": {
            "enum": [
              "porcini",
              "ovoli",
              "gallinacci",
              "combined"
            ],
            "title": "Species",
            "type": "string"
          }
        },
        "required": [
          "species",
          "date",
          "cells"
        ],
        "title": "ScoresResponse",
        "type": "object"
      },
      "SightingCount": {
        "description": "Never coordinates (PRD -> Principles -> Sightings privacy): a count per\ncell, source and license.",
        "properties": {
          "cell_id": {
            "title": "Cell Id",
            "type": "string"
          },
          "count": {
            "minimum": 1.0,
            "title": "Count",
            "type": "integer"
          },
          "license": {
            "title": "License",
            "type": "string"
          },
          "source": {
            "enum": [
              "gbif",
              "inaturalist"
            ],
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "cell_id",
          "source",
          "license",
          "count"
        ],
        "title": "SightingCount",
        "type": "object"
      },
      "SightingsResponse": {
        "properties": {
          "counts": {
            "items": {
              "$ref": "#/components/schemas/SightingCount"
            },
            "title": "Counts",
            "type": "array"
          },
          "since": {
            "format": "date",
            "title": "Since",
            "type": "string"
          },
          "species": {
            "enum": [
              "porcini",
              "ovoli",
              "gallinacci"
            ],
            "title": "Species",
            "type": "string"
          }
        },
        "required": [
          "species",
          "since",
          "counts"
        ],
        "title": "SightingsResponse",
        "type": "object"
      },
      "SpeciesForecast": {
        "properties": {
          "days": {
            "items": {
              "$ref": "#/components/schemas/DayScore"
            },
            "title": "Days",
            "type": "array"
          },
          "species": {
            "enum": [
              "porcini",
              "ovoli",
              "gallinacci"
            ],
            "title": "Species",
            "type": "string"
          }
        },
        "required": [
          "species",
          "days"
        ],
        "title": "SpeciesForecast",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Fruiting-conditions scores, cell detail, hotspots and sightings for wild edible mushrooms in Tuscany. Scores are a 0-1 conditions index, never a probability or an edibility claim.",
    "title": "mushma API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/cells/{cell_id}": {
      "get": {
        "operationId": "get_cell_cells__cell_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "cell_id",
            "required": true,
            "schema": {
              "title": "Cell Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CellDetailResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "unknown cell id"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Score, 7-day outlook and factor breakdown for every species in one cell"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/hotspots": {
      "get": {
        "operationId": "get_hotspots_hotspots_get",
        "parameters": [
          {
            "in": "query",
            "name": "species",
            "required": true,
            "schema": {
              "enum": [
                "porcini",
                "ovoli",
                "gallinacci",
                "combined"
              ],
              "title": "Species",
              "type": "string"
            }
          },
          {
            "description": "defaults to today, Europe/Rome",
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "defaults to today, Europe/Rome",
              "title": "Date"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 10,
              "maximum": 50,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HotspotsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "date outside the served window"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ranked clusters of high-scoring cells, with nearby recent sightings"
      }
    },
    "/scores": {
      "get": {
        "operationId": "get_scores_scores_get",
        "parameters": [
          {
            "in": "query",
            "name": "species",
            "required": true,
            "schema": {
              "enum": [
                "porcini",
                "ovoli",
                "gallinacci",
                "combined"
              ],
              "title": "Species",
              "type": "string"
            }
          },
          {
            "description": "defaults to today, Europe/Rome",
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "defaults to today, Europe/Rome",
              "title": "Date"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoresResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "date outside the served window"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Whole-region grid of conditions scores for one species (or combined)"
      }
    },
    "/sightings": {
      "get": {
        "operationId": "get_sightings_sightings_get",
        "parameters": [
          {
            "in": "query",
            "name": "species",
            "required": true,
            "schema": {
              "enum": [
                "porcini",
                "ovoli",
                "gallinacci"
              ],
              "title": "Species",
              "type": "string"
            }
          },
          {
            "description": "defaults to one year ago",
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "defaults to one year ago",
              "title": "Since"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SightingsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Public sighting counts per cell (never coordinates)"
      }
    },
    "/spot": {
      "get": {
        "operationId": "get_spot_spot_get",
        "parameters": [
          {
            "in": "query",
            "name": "lat",
            "required": true,
            "schema": {
              "maximum": 90,
              "minimum": -90,
              "title": "Lat",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "lon",
            "required": true,
            "schema": {
              "maximum": 180,
              "minimum": -180,
              "title": "Lon",
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CellDetailResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Score, 7-day outlook and factor breakdown for every species at a point"
      }
    }
  }
}
