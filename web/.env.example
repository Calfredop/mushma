# The API. `/api` goes through the Vite dev/preview proxy to API_PROXY_TARGET.
# In production point it at the API (or a host rewrite to it).
# `pnpm run tunnel` forces /api for its run, whatever this says.
VITE_API_BASE_URL=/api
API_PROXY_TARGET=http://localhost:8000

# Basemap (PRD → Architecture → Basemap). Run scripts/extract-basemap.sh first;
# the dev server serves web/data/basemap/ at /basemap/. A URL ending in
# .pmtiles is read with range requests, anything else is treated as TileJSON.
# Leave both empty to draw a plain land fill.
VITE_BASEMAP_URL=/basemap/tuscany.pmtiles
VITE_TERRAIN_URL=/basemap/tuscany-terrain.pmtiles

# Self-hosted Umami analytics (feat-umami-integration.md), set on Vercel for Production only —
# never Preview, so a preview deployment sends nothing even though it's still a `vite build`
# (README.md -> Deploying). Unset (the default here) means analytics.ts never loads the tracker,
# in dev or otherwise.
# VITE_UMAMI_SRC=https://m.mappafunghi.app/widget.js
# VITE_UMAMI_WEBSITE_ID=
# VITE_UMAMI_DOMAINS=mappafunghi.app
