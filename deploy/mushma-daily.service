# The daily pipeline (api/src/api/jobs/daily.py) as a one-off container of the API image. That
# container bumps the Redis response-cache generation after each successful region; then an API
# restart clears anything still held in the running process (grid cells, etc.). Started by
# mushma-daily.timer. Install: README.md -> Deploying.
[Unit]
Description=mushma daily pipeline
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/mushma/deploy
# Redis must be up before the oneshot runs: bump_region talks to it, and `compose run` alone does
# not wait on the long-running redis service's healthcheck.
ExecStartPre=/usr/bin/docker compose up -d redis
ExecStart=/usr/bin/docker compose run --rm api python -m api.jobs.daily
ExecStartPost=/usr/bin/docker compose restart api
TimeoutStartSec=2h
