# Copy to deploy/.env on the server (gitignored). Read by both the API and the daily job.

# The production web origins. Vercel preview deployments (*.vercel.app) stay allowed through the
# API's default CORS_ORIGIN_REGEX.
CORS_ORIGINS=https://mappafunghi.app,https://www.mappafunghi.app

# Monitoring (README.md -> Monitoring; all optional, unset is a no-op):
# ALERT_WEBHOOK_URL=      # api.jobs.daily posts one line here on a failed step
# HEARTBEAT_URL=          # api.jobs.daily pings this (a plain GET) once it finishes successfully
# SENTRY_DSN=             # error tracking for the API
