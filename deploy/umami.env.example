# Copy to deploy/umami.env on the server (gitignored). Read by both the umami and umami-db
# services (deploy/compose.yaml). Generate fresh secrets on the server, never reuse these.

# A random string that signs Umami's auth tokens. Generate with: openssl rand -hex 32
APP_SECRET=

# umami-db's own credentials. Generate the password with: openssl rand -hex 16
POSTGRES_USER=umami
POSTGRES_PASSWORD=
POSTGRES_DB=umami

# Must repeat POSTGRES_PASSWORD above: Docker Compose doesn't expand one env_file entry inside
# another. Host is the umami-db service name, resolved on the compose network.
DATABASE_URL=postgresql://umami:REPLACE_WITH_POSTGRES_PASSWORD@umami-db:5432/umami
